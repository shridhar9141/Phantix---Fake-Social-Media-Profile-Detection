# ==============================================================================
# Phantix — Fake Social Media Profile Detection & Investigation System
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production / Railway Environment Variables (Set in Railway Dashboard)
# ------------------------------------------------------------------------------
# PostgreSQL Database URL (Automatically supplied when adding a PostgreSQL service in Railway)
DATABASE_URL=postgresql+psycopg://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# Server runtime port (Automatically provided by Railway $PORT)
PORT=8000
ENVIRONMENT=production

# Firebase Project & Credentials
FIREBASE_PROJECT_ID=fake-social-media-detect-4bf0a
# Optional Firebase Service Account credentials for Admin SDK
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Application Secret Key
JWT_SECRET_KEY=generate_a_secure_random_64_character_secret_key

# Allowed CORS Origins (In production with one-URL architecture, requests are same-origin)
ALLOWED_ORIGINS=https://YOUR-PHANTIX-DOMAIN.up.railway.app

# Optional Threat Intelligence API Keys
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# ------------------------------------------------------------------------------
# 2. Frontend / Client Build Variables
# ------------------------------------------------------------------------------
# In production single-domain deployment, API requests use same-origin relative path:
VITE_API_BASE_URL=/api/v1

# Firebase Client Web SDK Config (From Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=AIzaSyAYwHbLX1HEPIuovsXdafa6uOHkA9mWAnU
VITE_FIREBASE_AUTH_DOMAIN=fake-social-media-detect-4bf0a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fake-social-media-detect-4bf0a
VITE_FIREBASE_STORAGE_BUCKET=fake-social-media-detect-4bf0a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=382068959219
VITE_FIREBASE_APP_ID=1:382068959219:web:f01741f1c608c82ecf9486
